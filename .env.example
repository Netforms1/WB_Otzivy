# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini модель
GEMINI_MODEL=gemini-2.5-flash

# Telegram user_id админов через запятую (только они могут пользоваться ботом)
ADMIN_IDS=

# Интервал автоответа в минутах
AUTO_INTERVAL_MIN=30

# Сколько отзывов забирать за один цикл
BATCH_SIZE=20

# Путь к БД
DB_PATH=bot.db
